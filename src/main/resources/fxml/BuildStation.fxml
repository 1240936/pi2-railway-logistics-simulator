<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="300" prefWidth="500" spacing="12" style="-fx-padding: 20; -fx-alignment: TOP_CENTER;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.BuildStationGUI">

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Build Station" />

    <HBox spacing="10">
        <Label text="Scenario:" />
        <ComboBox fx:id="scenarioComboBox" prefWidth="250" />
    </HBox>

    <HBox spacing="10">
        <Label text="X Coordinate:" />
        <TextField prefWidth="100" fx:id="xField" />
        <Label text="Y Coordinate:" />
        <TextField fx:id="yField" prefWidth="100" />
    </HBox>

    <HBox spacing="10">
        <Label text="Station Type:" />
        <ComboBox fx:id="stationTypeComboBox" prefWidth="250" />
    </HBox>

    <HBox fx:id="compassDirectionBox" managed="false" spacing="10" visible="false">
        <Label text="Compass Direction (NE, SE, NW, SW):" />
        <TextField fx:id="compassDirectionField" prefWidth="100" />
    </HBox>

    <HBox spacing="10">
        <Label text="Station Name:" />
        <TextField fx:id="nameField" prefWidth="250" />
        <Button fx:id="proposeNameButton" text="Propose Name" />
    </HBox>

    <HBox spacing="20">
        <Button fx:id="buyButton" text="Buy Station" />
        <Label fx:id="feedbackLabel" style="-fx-text-fill: darkred;" text="" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" prefWidth="400">
        <Label text="Budget:" minWidth="100"/>
        <Label fx:id="budgetLabel" text="0" prefWidth="60" style="-fx-border-color: lightgray; -fx-padding: 2;"/>
        <Label text="Cost:" minWidth="50"/>
        <Label fx:id="costLabel" text="0" prefWidth="60" style="-fx-border-color: lightgray; -fx-padding: 2;"/>
    </HBox>


</VBox>
